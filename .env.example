# Gateway (services/gateway). Every variable is optional; defaults suit local development.
DATABASE_URL=postgres://terminalpulse:terminalpulse@localhost:5432/terminalpulse
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
ML_URL=http://localhost:8000

# Which parts this process runs: ingest, persist, api, jobs, sim
ROLES=ingest,persist,api,jobs
PORT=8080

# Single-container mode (Render free tier): in-process MQTT broker + bundled simulator
# MQTT_EMBEDDED=true
# MQTT_WS_ENABLED=true
# MQTT_USERNAME=terminal
# MQTT_PASSWORD=change-me
# SIM_TERMINALS=150

# Protects POST /api/terminals/:id/commands (dashboard + MCP send it as x-api-key)
# ADMIN_API_KEY=change-me

# Tuning
# MQTT_INGEST_CONNECTIONS=4   parallel MQTT connections per ingest process (shared subscription)
# BATCH_SIZE=500              max stream entries per Postgres transaction
# PERSIST_CONCURRENCY=2       persist workers per process
# STREAM_MAXLEN=500000        approximate Redis stream cap
# CHAOS_NOACK_RATE=0          fraction of batches left un-acked to force redelivery (testing)
# RETENTION_HOURS=24          transactions older than this are pruned (also the dedupe window)

# MCP server (services/mcp-server)
# TERMINALPULSE_API_URL=http://localhost:8080
# TERMINALPULSE_API_KEY=change-me
